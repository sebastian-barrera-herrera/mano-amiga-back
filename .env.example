# ── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Orígenes permitidos (separados por coma). Usa * sólo en desarrollo.
CORS_ORIGINS=http://localhost:5173

# ── Base de datos (Neon) ────────────────────────────────────────────────────
# Copia la "pooled connection string" de Neon.
# Usa sslmode=verify-full en lugar del sslmode=require que sugiere Neon: hoy se
# comportan igual, pero `pg` v9 debilitará el significado de `require`.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# Sólo para servidores con certificado autofirmado. Con Neon, déjalo sin definir.
# DATABASE_SSL_NO_VERIFY=true

# ── Autenticación (opcional para el usuario, obligatoria en el servidor) ────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=30d

# Client ID de Google (Google Cloud > Credenciales > OAuth 2.0).
# Si se deja vacío, el inicio de sesión con Google queda deshabilitado.
GOOGLE_CLIENT_ID=

# Correos que reciben rol de administrador al registrarse (separados por coma).
ADMIN_EMAILS=

# ── Cloudinary (opcional) ───────────────────────────────────────────────────
# Si se dejan vacíos, las fotos se guardan en PostgreSQL. Con estas tres
# variables, el navegador las sube directamente al CDN de Cloudinary, que es
# más rápido y no gasta ancho de banda del servidor.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=manoamiga

# URL pública de la API. Sólo necesaria si las fotos van a la base de datos y
# el proxy no propaga el host original; normalmente se deduce sola.
# PUBLIC_API_URL=https://mano-amiga-back.onrender.com
